{
  "rules": {
    ".read": false,
    ".write": false,
    "registrations": {
      ".read": "auth != null && root.child('authorAccess').child(auth.uid).val() == true",
      ".write": true
    },
    "helpRequests": {
      ".read": "auth != null && root.child('authorAccess').child(auth.uid).val() == true",
      ".write": true
    },
    "authorAccess": {
      ".read": "auth != null && root.child('authorAccess').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('authorAccess').child(auth.uid).val() == true"
    }
  }
}